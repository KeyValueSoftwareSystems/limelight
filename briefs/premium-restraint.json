{
 "id": "premium-restraint",
 "name": "Premium, restrained",
 "note": "Luxury-goods register. Few cuts, long holds, calm camera. The edit should feel like it is withholding something. Doing less is the point, not a compromise.",
 "format": {"width": 1920, "height": 1080, "fps": 25},
 "budgets": {"cuts_per_minute": 9, "min_shot_s": 2.0, "max_shot_s": 9.0},
 "restraint": {"allow_no_change": true, "min_rest_s": 6.0, "hold_before_major_s": 4.0, "preserve_headroom": true},
 "prefers": {
  "camera_motion_px_s": [0, 70],
  "subject_motion_px_s": [0, 90],
  "brightness": [0.22, 0.62],
  "contrast": [0.10, 0.35],
  "saturation": [0.0, 0.55]
 },
 "salience_floor": 0.55,
 "callbacks": {"repeat_visual_on_repeated_music": true, "max_reuses_per_clip": 2}
}
