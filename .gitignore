# never commit music
songs/**/audio.*
*.mp3
*.wav
*.flac
*.m4a
*.aac

# never commit model weights
models/
*.pt
*.pth
*.safetensors
*.bin

# generated
maps/**/vectors/
*.f16
*.npy

# the usual
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.DS_Store
.env
*.log


# packs carry the mp3 for testing; the repo never does
*.zip

# synthetic renders regenerate in seconds; the repo holds scores, never songs
synth/out/

# songs you bring in: audio stays out of git, the map goes in
synth/incoming/

# the answer key. Never committed — this is the whole point of holding it out.
synth/truth/

# audio-derived analysis cache, never in the repo
*.bands.json

# One append-only line per eval run, per machine. Committing it means a conflict
# every time two people run the harness on the same day, and the file is not worth
# one: every line is reproducible by running mapeval again, and its real purpose is
# letting one person see whether their own change helped.
synth/learning/mapeval.jsonl
