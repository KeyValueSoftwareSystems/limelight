# never commit music
songs/**/audio.*
*.mp3
*.wav
*.flac
*.m4a
*.aac

# never commit model weights
models/
*.pt
*.pth
*.safetensors
*.bin

# generated
maps/**/vectors/
*.f16
*.npy

# the usual
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.DS_Store
.env
*.log


# packs carry the mp3 for testing; the repo never does
*.zip

# synthetic renders regenerate in seconds; the repo holds scores, never songs
synth/out/

# songs you bring in: audio stays out of git, the map goes in
synth/incoming/

# the answer key. Never committed — this is the whole point of holding it out.
synth/truth/

# audio-derived analysis cache, never in the repo
*.bands.json

# One append-only line per eval run, per machine. Committing it means a conflict
# every time two people run the harness on the same day, and the file is not worth
# one: every line is reproducible by running mapeval again, and its real purpose is
# letting one person see whether their own change helped.
synth/learning/mapeval.jsonl

# generated, large, and reproducible: stems, cloned model repos, virtualenvs
work/

# listener output and scratch scores -- regenerable in seconds from the audio,
# and 1.6 MB of JSON that changes on every run is noise in a diff. The PROMOTED
# map is committed (synth/best/) because that is the one everything is measured
# against; the attempts that produced it are not.
synth/maps/fresh*/
synth/maps/_*/
synth/maps/edited/

# Video assets: rule 1 applies to footage for the same reason it applies to
# audio, and the Mixkit licence forbids redistributing clips as stock anyway.
# assets/stock/CATALOGUE.json is committed and is enough to fetch the set again.
assets/stock/clips/
assets/incoming/
assets/generated/*.mp4
renders/
