  },
  {
   "id": "trade",
   "name": "Trade",
   "kind": "gesture",
   "tier": 2,
   "blurb": "Place: one half hands to the other, returns. A call and response in light.",
   "dimension": "place",
   "returns": true,
   "dials": {
    "colours":    { "default": [[1, 0.75, 0.35], [0.2, 0.4, 1]] },
    "for_beats":  { "default": 2, "min": 1, "max": 8 },
    "travel":     { "default": true }
   },
   "fires_on": ["entrance and exit sharing a timestamp"],
   "min_fixtures": 4,
   "requires": ["colour", "level"],
   "default_beats": 2
  },
  {
   "id": "isolate",
   "name": "Isolate",
   "kind": "gesture",
   "tier": 2,
   "blurb": "Place to one lamp, holds for its span. Needs at least three lamps to read as isolation.",
   "dimension": "place",
   "returns": true,
   "dials": {
    "which":      { "default": null },
    "colour":     { "default": [1, 0.75, 0.35] },
    "rest":       { "default": 0.06, "min": 0, "max": 0.3 }
   },
   "fires_on": ["a named instrument entering alone"],
   "min_fixtures": 3,
   "requires": ["colour", "level"],
   "default_beats": 4
  },
  {
   "id": "strip",
   "name": "Strip",
   "kind": "gesture",
   "tier": 2,
   "blurb": "Amount down to the state's floor, settle, holds. A controlled pull-back.",
   "dimension": "amount",
   "returns": false,
   "dials": {
    "to":         { "default": 0.1, "min": 0, "max": 0.5 },
    "over_beats": { "default": 4, "min": 1, "max": 16 }
   },
   "fires_on": ["breakdown"],
   "min_fixtures": 1,
   "requires": ["level"],
   "default_beats": 4
  },
  {
   "id": "cut",
   "name": "Cut",
