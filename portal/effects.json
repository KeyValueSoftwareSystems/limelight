   "dimension": "amount",
   "returns": true,
   "dials": {
    "colour":     { "default": [1, 0.75, 0.35] },
    "extent":     { "default": "inner" },
    "for_beats":  { "default": 1, "min": 1, "max": 4 }
   },
   "fires_on": ["middling entrance"],
   "min_fixtures": 2,
   "requires": ["colour", "level"],
   "default_beats": 1
  },
  {
   "id": "lift",
   "name": "Lift",
