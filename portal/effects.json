    "smooth":     { "default": 0.3, "min": 0, "max": 1 }
   },
   "fires_on": ["a section where one instrument leads"],
   "min_fixtures": 1,
   "requires": ["level"],
   "default_beats": 0
  },
  {
   "id": "split",
   "name": "Split",
