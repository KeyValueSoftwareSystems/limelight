   "type": "float",
   "min": 0,
   "max": 1,
   "label": "Amount"
  },
  "colour": {
   "type": "colour",
   "label": "Colour"
  },
  "colours": {
   "type": "colour_pair",
   "label": "Colours"
  },
  "extent": {
   "type": "enum",
   "values": [
