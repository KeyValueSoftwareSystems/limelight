# Rule 1: no audio in git, ever. The generator ships; the recording does not.
*.wav
*.mp3
*.flac
*.m4a
*.aac
synth/out/
synth/incoming/

# The held-out answers. The whole point of holding a reference out is that a
# model cannot be tuned to reproduce a file, which stops being true the moment
# the file is in the repository everyone clones.
synth/truth/

# Measured maps, run logs and vectors -- regenerable, and large.
synth/maps/
synth/learning/
*.f16
*.npy

# Model weights never live here.
models/
*.pt
*.pth
*.safetensors

__pycache__/
*.pyc
node_modules/
.venv/

# Static ffmpeg/ffprobe binaries (downloaded locally; not committed).
tools/bin/ffmpeg
tools/bin/ffprobe

# Source material and the environments that read it. 22 GB between them on this
# machine: 3.4 GB of footage, 391 MB of renders, 18 GB of Python environments.
#
# The footage is the video reader's material, the way a layout is the lighting
# reader's. It is also, mostly, somebody else's -- the licences permit use and
# forbid redistributing the assets as stock, which is exactly what committing
# them would be. A catalogue naming each clip, its source and its sha256 is
# enough to fetch the identical set again, the same way the generator ships
# instead of the recording.
assets/
renders/
work/

# What people share through the hub is shared, not committed.
hub/files/
docs/server/node_modules/
work/sep/
work/sep-test/

# Scores are built from audio the way maps are: regenerable, and large. The
# .score.json rule is the only thing covering readers/lights/panel/scores/,
# which the panel writes on every hub import.
*.score
*.score.json
/docs
.venv
/tools
# the effect picker (readers/lights/play.js) renders here for the panel to play
readers/lights/panel/preview.lights.json
readers/lights/panel/preview.frames.json
.venv-panel/
scores/
audio/
files.zip
portal/work/
