{
 "note": "The official Limelight effect catalog. Every effect is a change to ONE dimension of light (amount, colour, place, rate). A named effect is a preset: a saved set of values over the four dimensions. Its dials are the creator's interface. The renderer needs no special case for any of them. Derived from the protocol response for raga-of-revenge. See effects.md and architecture.md for the design.",
 "schema_version": 2,
 "dimensions": ["amount", "colour", "place", "rate"],
 "dial_types": {
  "amount":     { "type": "float", "min": 0, "max": 1, "label": "Amount" },
  "colour":     { "type": "colour", "label": "Colour" },
  "colours":    { "type": "colour_pair", "label": "Colours" },
  "extent":     { "type": "enum", "values": ["all", "inner", "outer", "ends", "left", "right", "single"], "label": "Extent" },
  "for_beats":  { "type": "int", "min": 1, "max": 64, "label": "Duration (beats)" },
  "over_beats": { "type": "int", "min": 1, "max": 64, "label": "Over (beats)" },
  "depth":      { "type": "float", "min": 0, "max": 1, "label": "Depth" },
  "by":         { "type": "float", "min": 0, "max": 1, "label": "By" },
  "to":         { "type": "float", "min": 0, "max": 1, "label": "To" },
  "from":       { "type": "float", "min": 0, "max": 1, "label": "From" },
  "threshold":  { "type": "float", "min": 0, "max": 1, "label": "Threshold" },
  "smooth":     { "type": "float", "min": 0, "max": 1, "label": "Smooth" },
  "rise":       { "type": "float", "min": 0, "max": 1, "label": "Rise" },
  "rest":       { "type": "float", "min": 0, "max": 1, "label": "Rest level" },
  "curve":      { "type": "enum", "values": ["linear", "ease", "settle"], "label": "Curve" },
  "travel":     { "type": "bool", "label": "Travels" },
  "tilt":       { "type": "float", "min": 0, "max": 1, "label": "Tilt" },
  "which":      { "type": "fixture", "label": "Which fixture" },
  "keep":       { "type": "fixture_set", "label": "Keep lit" },
  "stream":     { "type": "stream", "label": "Stream" },
  "streams":    { "type": "stream_pair", "label": "Streams" }
 },
 "effects": [
  {
   "id": "drone",
   "name": "Drone",
   "kind": "state",
   "tier": 1,
   "blurb": "A few lamps at low level, still. The resting condition of a quiet section.",
   "dimension": "amount",
   "returns": false,
   "dials": {
    "amount":  { "default": 0.12, "min": 0.04, "max": 0.25 },
    "colour":  { "default": [1, 0.75, 0.35] },
    "extent":  { "default": "inner" }
   },
   "fires_on": ["quiet section", "intro", "outro"],
   "min_fixtures": 1,
   "requires": ["colour", "level"],
   "default_beats": 0
  },
  {
   "id": "wash",
   "name": "Wash",
   "kind": "state",
   "tier": 1,
   "blurb": "All lamps at mid level, one colour. The resting condition of a full section.",
   "dimension": "amount",
   "returns": false,
   "dials": {
    "amount":  { "default": 0.55, "min": 0.3, "max": 0.8 },
    "colour":  { "default": [0.2, 0.4, 1] },
    "extent":  { "default": "all" }
   },
   "fires_on": ["full section", "verse", "drop"],
   "min_fixtures": 1,
   "requires": ["colour", "level"],
   "default_beats": 0
  },
  {
   "id": "impact",
   "name": "Impact",
   "kind": "gesture",
   "tier": 1,
   "blurb": "Amount to full, step, all fixtures, returns. The biggest gesture available.",
   "dimension": "amount",
   "returns": true,
   "dials": {
    "colour":     { "default": [1, 1, 1] },
    "extent":     { "default": "all" },
    "for_beats":  { "default": 1, "min": 1, "max": 4 }
   },
   "fires_on": ["peak"],
   "min_fixtures": 1,
   "requires": ["colour", "level"],
   "default_beats": 1
  },
  {
   "id": "blackout",
   "name": "Blackout",
   "kind": "gesture",
   "tier": 1,
   "blurb": "Amount to zero, step, all fixtures, returns. Darkness is the strongest gesture.",
   "dimension": "amount",
   "returns": true,
   "dials": {
    "for_beats":  { "default": 1, "min": 1, "max": 8 }
   },
   "fires_on": ["the beat before a peak", "deep exit"],
   "min_fixtures": 1,
   "requires": ["level"],
   "default_beats": 1
  },
  {
   "id": "hush",
   "name": "Hush",
   "kind": "gesture",
   "tier": 1,
