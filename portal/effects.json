   "type": "float",
   "min": 0,
   "max": 1,
   "label": "Threshold"
  },
  "smooth": {
   "type": "float",
   "min": 0,
   "max": 1,
   "label": "Smooth"
  },
  "rise": {
   "type": "float",
   "min": 0,
