    "inner",
    "outer",
    "ends",
    "left",
    "right",
    "single"
   ],
   "label": "Extent"
  },
  "for_beats": {
   "type": "int",
   "min": 1,
   "max": 64,
   "label": "Duration (beats)"
  },
  "over_beats": {
