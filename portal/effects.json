  "amount": {
   "type": "float",
   "min": 0,
   "max": 1,
   "label": "Amount"
  },
  "colour": {
   "type": "colour",
   "label": "Colour"
  },
  "colours": {
   "type": "colour_pair",
   "label": "Colours"
  },
  "extent": {
   "type": "enum",
   "values": [
    "all",
    "inner",
    "outer",
    "ends",
    "left",
    "right",
    "single"
   ],
   "label": "Extent"
  },
  "for_beats": {
   "type": "int",
   "min": 1,
   "max": 64,
   "label": "Duration (beats)"
  },
  "over_beats": {
   "type": "int",
   "min": 1,
   "max": 64,
   "label": "Over (beats)"
  },
  "depth": {
