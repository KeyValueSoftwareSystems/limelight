   },
   "fires_on": ["rhythm_change where the beat drops away"],
   "min_fixtures": 1,
   "requires": ["level"],
   "default_beats": 1
  },
  {
   "id": "swell",
   "name": "Swell",
   "kind": "gesture",
   "tier": 2,
